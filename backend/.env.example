# ---- LLM providers (all optional; system falls back to heuristics) ----
# Local SLM via Ollama (install: https://ollama.com, then: ollama pull qwen2.5:3b-instruct)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# HuggingFace Inference API (free tier) - https://huggingface.co/settings/tokens
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Groq free tier (fast SLMs) - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ---- Search defaults ----
DEFAULT_COUNTRY=India
DEFAULT_HOURS_OLD=168
DEFAULT_RESULTS_PER_SITE=30

# ---- Storage ----
# Paths are relative to backend/ unless absolute
DATA_DIR=data